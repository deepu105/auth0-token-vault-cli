{
  "name": "auth0-token-vault-cli",
  "version": "0.1.0",
  "description": "Auth0 Token Vault CLI — Access third-party services (Gmail, Slack, etc.) on behalf of authenticated users via Auth0 Token Vault. Designed for both humans and AI agents.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "auth0-tv": "dist/index.js"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "verify": "npm run check && npm test",
    "prebuild": "npm run check",
    "build": "rm -rf dist && tsc",
    "postbuild": "shx chmod +x dist/*.js",
    "release:check": "npm run test:all && npm run build",
    "release:publish": "npm publish --provenance",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:all": "npm run verify && npm run test:e2e",
    "test:e2e": "rm -rf dist && tsc && shx chmod +x dist/*.js && vitest run --config vitest.e2e.config.ts",
    "test:e2e:watch": "rm -rf dist && tsc && shx chmod +x dist/*.js && vitest --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"**/*.{js,ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,json,md}\"",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "keywords": [
    "auth0",
    "token-vault",
    "cli",
    "gmail",
    "ai-agent",
    "oauth"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/deepu105/auth0-token-vault-cli"
  },
  "author": "Deepu Sasidharan <d4udts@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "@slack/web-api": "^7.15.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "debug": "^4.4.0",
    "googleapis": "^171.4.0",
    "jwt-decode": "^4.0.0",
    "keytar": "^7.9.0",
    "open": "^10.1.0",
    "openid-client": "^6.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@types/debug": "^4.1.12",
    "@types/node": "^22.14.0",
    "@vitest/coverage-v8": "^3.1.1",
    "eslint": "9.23.0",
    "eslint-config-prettier": "^10.1.1",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "msw": "^2.7.3",
    "prettier": "^3.5.3",
    "shx": "^0.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.29.0",
    "vitest": "^3.1.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  }
}
